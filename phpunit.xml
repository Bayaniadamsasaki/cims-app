<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>

        <!-- Group RADIUS bawaan dikosongkan supaya nilai HOTSPOT_RADIUS_DEFAULT_GROUP
             di .env mesin pengembang tidak ikut menentukan hasil test: profile yang
             diuji selalu dipatok config() di dalam test-nya sendiri. -->
        <env name="HOTSPOT_RADIUS_DEFAULT_GROUP" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>

        <!-- Koneksi RADIUS diarahkan ke sqlite :memory: agar test tidak pernah
             menyentuh database FreeRADIUS yang sebenarnya. RADIUS_DB_USERNAME
             diisi supaya RadiusService::configured() tetap bernilai true. -->
        <env name="RADIUS_DB_CONNECTION" value="sqlite"/>
        <env name="RADIUS_DB_DATABASE" value=":memory:"/>
        <env name="RADIUS_DB_USERNAME" value="testing"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
